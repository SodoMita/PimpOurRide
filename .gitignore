# Build output
/bin/
/.generated/

# Runtime-generated screenshots (never commit raw frame captures —
# docs/hero.webp is the curated, compressed exception, added deliberately)
/screenshots/*.webp

# PNG is banned project-wide (see AGENTS.md) — belt-and-suspenders in case
# one ever gets created locally, it must never be staged.
*.png
!/screenshots/.gitkeep

# noVNC static assets staged by tools/prepare-viewer.sh (symlinks to the
# system novnc package, not project content)
/tools/viewer/core
/tools/viewer/vendor

# Editor/OS cruft
*.o
*.swp
.DS_Store
